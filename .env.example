NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
# Signs the login cookie. Any long random string; required in production.
NADO_SESSION_SECRET=
# 1 = email the 6-digit code through Supabase Auth (the email template must include {{ .Token }}).
# Empty = demo mode: nothing is sent and any 6 digits work.
NADO_EMAIL_OTP=
# 0 = turn off the demo routes (/api/demo/*: clock, quick setup, sample students, reset)
NADO_DEMO=
