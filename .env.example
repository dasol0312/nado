NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
# Optional: the every-minute timer (Supabase pg_cron) sends this as "Authorization: Bearer ..." to GET /api/match
CRON_SECRET=
# Signs the login cookie. Any long random string; required in production.
NADO_SESSION_SECRET=
# 1 = email the 6-digit code through Supabase Auth (the email template must include {{ .Token }}).
# Empty = demo mode: nothing is sent and any 6 digits work.
NADO_EMAIL_OTP=
# 0 = turn off the demo routes (/api/demo/*: the hidden clock, sample students confirming)
NADO_DEMO=

# Re-enables the retired /api/open-rooms route (local testing only)
# NADO_LEGACY_OPEN_ROOMS=1
